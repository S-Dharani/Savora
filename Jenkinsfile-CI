pipeline {
    agent any
    tools {
        maven 'maven'
    }
    environment {
            DOCKER_FRONT_IMG: 'dharani1001/savorafrontend'
            DOCKER_BACK_IMG: 'dharani1001/savorabackend'
    }
    stages {
        stage("Build Backend") {
            steps { 
                sh '''
                mvn clean package -DskipTests
                '''
                }
        }
        stage("Backend img Build") {
            steps {
                sh '''
                docker build -t $DOCKER_BACK_IMG backend/
                '''
            }
        }
        stage("Frontend img Build") {
            steps {
                sh '''
                docker build -t $DOCKER_FRONT_IMG frontend/
                '''
            }
        }
        stage("Docker login") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                    docker login -u $DOCKER_USER -p $DOCKER_PASS
                    '''
                }
            }
        }
        stage("Img push") {
            steps {
                sh '''
                docker push $DOCKER_FRONT_IMG
                docker push $DOCKER_BACK_IMG
                '''
            }
        }
        stage("clean workspace") {
            steps {
                cleanWs()
            }
        }
    }
}